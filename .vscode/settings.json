{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[bat]": {
    "files.eol": "\r\n",
    "files.trimTrailingWhitespace": false
  },
  "[shellscript]": {
    "files.eol": "\n"
  },
  "[powershell]": {
    "files.eol": "\r\n"
  }
}
